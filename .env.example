# Copy to .env (git-ignored) and fill in. Only the backend reads these.

# Local Docker Postgres (host port 5433, see docker-compose.yml)
POSTGRES_PASSWORD=repolens
# Used when running the backend on the host instead of in Docker:
DATABASE_URL=postgresql://repolens:repolens@127.0.0.1:5433/repolens
# pytest only; the name must end in _test (tests drop and rebuild its schema):
TEST_DATABASE_URL=postgresql://repolens:repolens@127.0.0.1:5433/repolens_test

# Ingestion limits
MAX_FILES=2000
MAX_FILE_BYTES=1000000
CLONE_TIMEOUT_S=120
MAX_ANALYSIS_S=600

# LLM (Day 3). Without a model and key, AI answers are unavailable; graph questions still work.
LLM_PROVIDER=anthropic
LLM_MODEL=
LLM_API_KEY=
# No temperature on current models; effort + thinking + model + PROMPT_VERSION fix behaviour.
# between_tools turns up-front thinking off (Sonnet 5.5; low/medium/high effort only).
# Haiku 5.5 documents only adaptive thinking: set LLM_THINKING=adaptive for it.
LLM_EFFORT=low
LLM_THINKING=between_tools
# AI question budget per analysis (input + output tokens); it does not reset.
LLM_TOKEN_CAP_PER_SNAPSHOT=500000
